# ── Required ────────────────────────────────────────────────────────
# Static API key — simplest auth. Use this or JWT (or both).
HEAVEN_API_KEY=your-secret-api-key-here

# ── JWT Auth (for web UI login) ─────────────────────────────────────
HEAVEN_JWT_SECRET=generate-a-long-random-string-here
HEAVEN_ADMIN_USER=admin
# Generate with: python -c "from src.auth import hash_password; print(hash_password('yourpassword'))"
HEAVEN_ADMIN_PASSWORD_HASH=

# ── LLM API (DeepSeek — only needed for /analyze) ───────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated origins, or "*" for all
CORS_ORIGINS=*

# ── Server ──────────────────────────────────────────────────────────
PORT=8000

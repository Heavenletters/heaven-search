# ── Required ────────────────────────────────────────────────────────
# Static API key — simplest auth. Use this or JWT (or both).
HEAVEN_API_KEY=your-secret-api-key-here

# ── JWT Auth (for web UI login) ─────────────────────────────────────
HEAVEN_JWT_SECRET=generate-a-long-random-string-here
HEAVEN_ADMIN_USER=admin
# Generate with: python -c "from src.auth import hash_password; print(hash_password('yourpassword'))"
HEAVEN_ADMIN_PASSWORD_HASH=

# ── Embedding Backend ──────────────────────────────────────────────
# Which embedding model to use. Options:
#   vertex  — Google text-embedding-004 (768-dim, cloud, best quality)
#   local   — BAAI/bge-base-en-v1.5 (768-dim, offline, good quality)
#   auto    — vertex with automatic local fallback (recommended)
#   minilm  — all-MiniLM-L6-v2 (384-dim, legacy, fast but shallow)
EMBEDDING_BACKEND=auto

# Vertex AI (required for EMBEDDING_BACKEND=vertex or auto)
# Get your API key at https://console.cloud.google.com/apis/credentials
VERTEX_API_KEY=
VERTEX_PROJECT=your-gcp-project-id

# ── LLM API (DeepSeek — only needed for /analyze) ───────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated origins, or "*" for all
CORS_ORIGINS=*

# ── Server ──────────────────────────────────────────────────────────
PORT=8000
